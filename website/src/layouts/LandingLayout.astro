---
import '../styles/app.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'The open-source Arduino UI framework. Define your UI in C++, control it from your phone.' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dragon">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://api.fonts.coollabs.io" crossorigin />
    <link rel="preconnect" href="https://cdn.fonts.coollabs.io" crossorigin />
  </head>
  <body class="min-h-screen bg-base-300 text-base-content font-inter leading-relaxed">
    <slot />
  </body>
</html>
