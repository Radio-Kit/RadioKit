---
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="nav-right">
    <div class="sl-hidden md:sl-flex print:hidden right-group">
      <div class="sl-flex social-icons">
        <SocialIcons />
      </div>
      <label for="theme-modal" id="theme-toggle" aria-label="Theme settings">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/><path d="M12 20v2"/>
          <path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/>
          <path d="M2 12h2"/><path d="M20 12h2"/>
          <path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>
        </svg>
        <svg class="icon-auto" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <path d="M12 2v2"/><path d="m4.93 4.93 1.41 1.41"/>
          <path d="M20 12h2"/><path d="m19.07 4.93-1.41 1.41"/>
          <path d="M15.947 12.65a4 4 0 0 0-5.925-4.128"/>
          <path d="M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z"/>
        </svg>
      </label>
      <LanguageSelect />
    </div>
  </div>
</div>

<!-- Theme Dialog (CSS-only DaisyUI modal) -->
<input type="checkbox" id="theme-modal" class="modal-toggle" />
<div class="modal" role="dialog">
  <div class="dialog-panel">
    <div class="dialog-header">
      <h2>Theme Settings</h2>
      <label for="theme-modal" aria-label="Close" class="dialog-close-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </label>
    </div>

    <div class="dialog-section">
      <h3 class="dialog-section-title">Mode</h3>
      <div class="mode-group" role="radiogroup" aria-label="Theme mode">
        <button class="mode-btn" data-mode="system" role="radio" aria-checked="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
          System
        </button>
        <button class="mode-btn" data-mode="dark" role="radio" aria-checked="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>
          </svg>
          Dark
        </button>
        <button class="mode-btn" data-mode="light" role="radio" aria-checked="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2"/><path d="M12 20v2"/>
            <path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/>
            <path d="M2 12h2"/><path d="M20 12h2"/>
            <path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
          </svg>
          Light
        </button>
      </div>
    </div>

    <div class="dialog-section">
      <h3 class="dialog-section-title">Dark Theme</h3>
      <div class="theme-grid" id="dark-themes"></div>
    </div>

    <div class="dialog-section">
      <h3 class="dialog-section-title">Light Theme</h3>
      <div class="theme-grid" id="light-themes"></div>
    </div>
  </div>
  <label class="modal-backdrop" for="theme-modal">Close</label>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      align-items: center;
      height: 100%;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: var(--sl-nav-gap);
      margin-inline-start: auto;
    }

    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    @media (min-width: 50rem) {
      .header {
        display: flex;
      }
    }

    #theme-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border: none;
      border-radius: 50%;
      background: transparent;
      color: var(--sl-color-gray-2);
      cursor: pointer;
      transition: color 0.2s, background 0.2s;
    }
    #theme-toggle:hover {
      color: var(--sl-color-white);
      background: var(--sl-color-bg-nav);
    }

    /* Theme Dialog (CSS-only modal) */
    .modal-toggle {
      display: none;
    }
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 100;
      justify-content: center;
      align-items: center;
    }
    .modal-toggle:checked ~ .modal {
      display: flex;
    }
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
    }
    .dialog-panel {
      grid-row: 1;
      grid-column: 1;
      background: var(--sl-color-bg-nav);
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 16px;
      padding: 24px;
      width: 360px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 16px 48px rgba(0,0,0,0.3);
      color: var(--sl-color-white);
      z-index: 1;
    }
    .dialog-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .dialog-header h2 {
      font-size: 1.15rem;
      margin: 0;
    }
    .dialog-close-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border: none;
      border-radius: 50%;
      background: transparent;
      color: var(--sl-color-gray-2);
      cursor: pointer;
      transition: color 0.2s, background 0.2s;
    }
    .dialog-close-btn:hover {
      color: var(--sl-color-white);
      background: var(--sl-color-bg-nav);
    }
    .dialog-section {
      margin-bottom: 20px;
    }
    .dialog-section-title {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--sl-color-accent);
      margin-bottom: 10px;
    }
    .mode-group {
      display: flex;
      gap: 6px;
      background: var(--sl-color-bg-inline-code);
      border-radius: 10px;
      padding: 4px;
    }
    .mode-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 12px;
      border: none;
      border-radius: 8px;
      background: transparent;
      color: var(--sl-color-gray-2);
      font-size: 0.82rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }
    .mode-btn[aria-checked="true"] {
      background: var(--sl-color-accent);
      color: var(--sl-color-black);
    }
    .mode-btn:hover:not([aria-checked="true"]) {
      color: var(--sl-color-white);
    }
    .theme-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }
    :global(.theme-swatch) {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 10px 6px 8px;
      border: 2px solid var(--sl-color-gray-5);
      border-radius: 10px;
      background: transparent;
      cursor: pointer;
      color: var(--sl-color-gray-2);
      transition: all 0.2s;
    }
    :global(.theme-swatch:hover) {
      border-color: var(--sl-color-gray-2);
    }
    :global(.theme-swatch.active) {
      border-color: var(--sl-color-accent);
      background: color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
    }
    :global(.theme-swatch-colors) {
      display: flex;
      gap: 3px;
    }
    :global(.theme-swatch-dot) {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.1);
    }
    :global(.theme-swatch-name) {
      font-size: 0.7rem;
      font-weight: 500;
      text-transform: capitalize;
    }
    :global(.theme-swatch.active .theme-swatch-name) {
      color: var(--sl-color-accent);
    }
  }
</style>

<script>
  const root = document.documentElement;
  const THEME_META = [
    {name:'abyss',scheme:'dark',colors:['#1a3345','#0f2a3a','#091a2a','#e6dcc0']},
    {name:'dragon',scheme:'dark',colors:['#362e24','#241f1a','#000000','#d4d0c8']},
    {name:'matrix',scheme:'dark',colors:['#142814','#1c301c','#264026','#e0f5d0']},
    {name:'bumblebee',scheme:'light',colors:['#ffffff','#f7f7f7','#ebebeb','#333333']},
    {name:'emerald',scheme:'light',colors:['#ffffff','#ededed','#dbdbdb','#2c3e4d']},
    {name:'minimal',scheme:'light',colors:['#ffffff','#f7f7f7','#efefef','#000000']},
    {name:'rose',scheme:'light',colors:['#f7eaee','#efe0e5','#e3c9d1','#8a2a4a']},
    {name:'vintage',scheme:'light',colors:['#faf4e8','#f2ead4','#e6dbba','#5c3c28']},
  ];
  const DARK_THEMES = THEME_META.filter(t => t.scheme === 'dark');
  const LIGHT_THEMES = THEME_META.filter(t => t.scheme === 'light');

  function getStored(key, fallback) {
    return localStorage.getItem(key) || fallback;
  }

  function store(key, value) {
    localStorage.setItem(key, value);
  }

  function resolveMode(mode) {
    if (mode === 'system') {
      return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    return mode;
  }

  function applyAll(mode, darkTheme, lightTheme) {
    const resolved = resolveMode(mode);
    const variant = resolved === 'dark' ? darkTheme : lightTheme;
    root.dataset.theme = resolved;
    root.dataset.themeVariant = variant;
    updateIcons(mode);
    updateModeUI(mode);
    updateThemeGrid('dark-themes', DARK_THEMES, darkTheme);
    updateThemeGrid('light-themes', LIGHT_THEMES, lightTheme);
    // Sync Starlight
    const slVal = mode === 'system' ? '' : mode;
    localStorage.setItem('starlight-theme', slVal);
    if (window.StarlightThemeProvider) {
      window.StarlightThemeProvider.updatePickers(slVal || resolved);
    }
  }

  function updateIcons(mode) {
    document.querySelectorAll('.icon-sun, .icon-moon, .icon-auto').forEach(el => {
      el.style.display = 'none';
    });
    const cls = mode === 'dark' ? '.icon-moon' : mode === 'light' ? '.icon-sun' : '.icon-auto';
    document.querySelectorAll(cls).forEach(el => {
      el.style.display = '';
    });
  }

  function updateModeUI(mode) {
    document.querySelectorAll('.mode-btn').forEach(btn => {
      btn.setAttribute('aria-checked', btn.dataset.mode === mode ? 'true' : 'false');
    });
  }

  function updateThemeGrid(id, themes, activeName) {
    const grid = document.getElementById(id);
    if (!grid) return;
    grid.innerHTML = themes.map(t => {
      const c = t.colors;
      return `<button class="theme-swatch${t.name === activeName ? ' active' : ''}" data-theme-name="${t.name}">
        <div class="theme-swatch-colors">
          ${c.slice(0,4).map(h => `<span class="theme-swatch-dot" style="background:${h}"></span>`).join('')}
        </div>
        <span class="theme-swatch-name">${t.name}</span>
      </button>`;
    }).join('');
    grid.querySelectorAll('.theme-swatch').forEach(el => {
      el.addEventListener('click', () => {
        const name = el.dataset.themeName;
        const meta = THEME_META.find(t => t.name === name);
        if (!meta) return;
        store('rk-mode', meta.scheme);
        if (meta.scheme === 'dark') {
          store('rk-dark-theme', name);
        } else {
          store('rk-light-theme', name);
        }
        applyAll(
          meta.scheme,
          getStored('rk-dark-theme', 'dragon'),
          getStored('rk-light-theme', 'bumblebee')
        );
      });
    });
  }

  // Init
  const savedMode = getStored('rk-mode', 'system');
  const savedDark = getStored('rk-dark-theme', 'dragon');
  const savedLight = getStored('rk-light-theme', 'bumblebee');
  applyAll(savedMode, savedDark, savedLight);

  // Mode buttons
  document.querySelectorAll('.mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.mode;
      store('rk-mode', mode);
      applyAll(mode, getStored('rk-dark-theme', 'dragon'), getStored('rk-light-theme', 'bumblebee'));
    });
  });

  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (getStored('rk-mode', 'system') === 'system') {
      applyAll('system', getStored('rk-dark-theme', 'dragon'), getStored('rk-light-theme', 'bumblebee'));
    }
  });
</script>
